package-lock=true
audit-level=high
fund=false
# Bloqueia postinstall/preinstall — um dos vetores mais comuns de pacote malicioso
ignore-scripts=true
# Versao exata no package.json (sem ^ ou ~)
save-exact=true
registry=https://registry.npmjs.org/
# Pacotes do escopo da empresa SO vem do registry interno (anti dependency confusion)
@empresa:registry=https://nexus.empresa.com.br/repository/npm-internal/
//nexus.empresa.com.br/repository/npm-internal/:always-auth=true
