    {
      "id": "esY9mIstAGpsR9lFSqnm1",
      "type": "text",
      "x": 1260.4414175768288,
      "y": 6443.814828352501,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
