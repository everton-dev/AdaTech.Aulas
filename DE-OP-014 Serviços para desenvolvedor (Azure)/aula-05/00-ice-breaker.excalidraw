    {
      "id": "NY87utNnRPHdPNmbrQSiO",
      "type": "text",
      "x": 1184.1238876185962,
      "y": 4824.621608890902,
      "width": 2044.165306188039,
      "height": 246.73393364480674,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
