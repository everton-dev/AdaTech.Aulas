      "text": "Criar uma Webapp no Azure - Portal",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Criar uma Webapp no Azure - Portal",
      "autoResize": true,
