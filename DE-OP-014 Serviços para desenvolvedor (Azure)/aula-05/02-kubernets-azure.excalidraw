      "link": null,
      "locked": false,
      "text": "# Criar Cluster AKS\naz aks create --resource-group azure-for-devs --name devCluster --node-count 3 --enable-addons monitoring --generate-\nssh-keys --node-vm-size Standard_DS2_v2\n\n# Configure o contexto do cluster no kubeconfig\naz aks get-credentials --resource-group azure-for-devs --name devCluster\n\n#Verifique se os nodes estão em ready\nkubectl get nodes\n\nOutput comando:",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Criar Cluster AKS\naz aks create --resource-group azure-for-devs --name devCluster --node-count 3 --enable-addons monitoring --generate-ssh-keys --node-vm-size Standard_DS2_v2\n\n# Configure o contexto do cluster no kubeconfig\naz aks get-credentials --resource-group azure-for-devs --name devCluster\n\n#Verifique se os nodes estão em ready\nkubectl get nodes\n\nOutput comando:",
      "autoResize": false,
      "lineHeight": 1.25
    },
