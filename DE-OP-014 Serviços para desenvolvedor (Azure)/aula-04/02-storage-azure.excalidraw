      "isDeleted": false,
      "boundElements": [],
      "updated": 1756495267543,
      "link": null,
      "locked": false,
      "text": "Funcionalidades\n- Escalabilidade",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Funcionalidades\n- Escalabilidade",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "NM2KznM44etdVXWwVzk1w",
      "type": "text",
      "x": 1191.6647728814023,
      "y": 1232.4444444444443,
      "width": 712.7347412109374,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4j",
      "roundness": null,
      "seed": 957804054,
      "version": 545,
      "versionNonce": 660501066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731442765945,
      "link": null,
      "locked": false,
      "text": "Camadas de Acesso\n- Hot (Quente): Para dados acessados com\nfrequência.\n\n- Cool (Fria): Para dados acessados raramente, com\ncustos de armazenamento mais baixos.\n\n- Could - Archive (Arquivo): Para dados que\nraramente ou nunca são acessados, com o menor\ncusto de armazenamento.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Camadas de Acesso\n- Hot (Quente): Para dados acessados com frequência.\n\n- Cool (Fria): Para dados acessados raramente, com custos de armazenamento mais baixos.\n\n- Could - Archive (Arquivo): Para dados que raramente ou nunca são acessados, com o menor custo de armazenamento.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "OSpfE3bZgi8crZDeRJ7PC",
      "type": "text",
      "x": 389.6647728814023,
      "y": 1618.4444444444443,
      "width": 712.7347412109374,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
