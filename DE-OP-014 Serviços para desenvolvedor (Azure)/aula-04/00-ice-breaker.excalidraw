    {
      "id": "SMPAjlX_XJJ4DgNBgXVPz",
      "type": "text",
      "x": 1031.798884959363,
      "y": 4554.121608890902,
      "width": 2044.165306188039,
      "height": 246.73393364480674,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
