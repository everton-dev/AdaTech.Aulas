    {
      "id": "ldT4ILMaefjXRARrDuoLz",
      "type": "text",
      "x": 880.0343724613331,
      "y": 7633.658051772862,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
