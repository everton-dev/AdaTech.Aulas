      "text": "chmod 400 ~/Downloads/myKey.pem\nssh -i ~/Downloads/myKey.pem azureuser@10.111.12.123\nsudo apt-get -y update\nsudo apt-get -y install nginx\ncd /var/www/html\nsudo nano index.html\ncolar html e salvar",
