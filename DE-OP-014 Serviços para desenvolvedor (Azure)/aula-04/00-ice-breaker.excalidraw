    },
    {
      "id": "yjXMOvBzi21LwcysmE-Gj",
      "type": "text",
      "x": 1082.8545795563987,
      "y": 6055.412639239014,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
