    {
      "id": "5Qg2Pw74CbDv8QL_V_mcr",
      "type": "text",
      "x": 947.6061909241007,
      "y": 4293.065763005792,
      "width": 2160.099004484413,
      "height": 241.37015247861504,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
