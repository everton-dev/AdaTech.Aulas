      "text": "Criar uma rede virtual no Azure - CLI",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Criar uma rede virtual no Azure - CLI",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BBFDwrGSkNC9T3TS3YwlG",
      "type": "text",
      "x": 363.4728656344945,
      "y": 1493.7277593424185,
      "width": 3080,
      "height": 425,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4I",
      "roundness": null,
      "seed": 870378902,
      "version": 351,
      "versionNonce": 1541569864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743538834748,
      "link": null,
      "locked": false,
      "text": "# Login no Azure\naz login\n\n# Criar um grupo de recursos se não existir\naz group create --name azure-for-devs --location BrazilSouth\n\n# Criar uma rede virtual\naz network vnet create --resource-group azure-for-devs --name AdaVNet --address-prefix 10.1.0.0/16 --subnet-name AdaSubRede1 --subnet-prefix 10.1.1.0/24\n\n# Criar um grupos de segurança de rede (NSG)\naz network nsg create --resource-group azure-for-devs --name AdaNSG\n\n# Criar regras de segurança\naz network nsg rule create --resource-group azure-for-devs --nsg-name AdaNSG --name PermitirSSH --protocol Tcp --direction Inbound --priority 1000 --source-address-prefixes '*' --source-port-ranges '*' --destination-address-prefixes '*' --destination-port-ranges 22 --access Allow\n\n# Associar o NSG a uma Sub-Rede\naz network vnet subnet update --vnet-name AdaVNet --name AdaSubRede1 --resource-group azure-for-devs --network-security-group AdaNSG",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Login no Azure\naz login\n\n# Criar um grupo de recursos se não existir\naz group create --name azure-for-devs --location BrazilSouth\n\n# Criar uma rede virtual\naz network vnet create --resource-group azure-for-devs --name AdaVNet --address-prefix 10.1.0.0/16 --subnet-name AdaSubRede1 --subnet-prefix 10.1.1.0/24\n\n# Criar um grupos de segurança de rede (NSG)\naz network nsg create --resource-group azure-for-devs --name AdaNSG\n\n# Criar regras de segurança\naz network nsg rule create --resource-group azure-for-devs --nsg-name AdaNSG --name PermitirSSH --protocol Tcp --direction Inbound --priority 1000 --source-address-prefixes '*' --source-port-ranges '*' --destination-address-prefixes '*' --destination-port-ranges 22 --access Allow\n\n# Associar o NSG a uma Sub-Rede\naz network vnet subnet update --vnet-name AdaVNet --name AdaSubRede1 --resource-group azure-for-devs --network-security-group AdaNSG",
      "autoResize": true,
      "lineHeight": 1.25
    },
