    {
      "id": "tSGWbPV-k_JO-vol4_4mc",
      "type": "text",
      "x": 3042.9815035286438,
      "y": 5124.620174575405,
      "width": 3240.4772834068485,
      "height": 362.0919663291494,
      "angle": 0,
      "strokeColor": "#1e1e1e",
