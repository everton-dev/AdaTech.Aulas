    {
      "id": "zNgI-mXZQZoOzEB_2fOxM",
      "type": "text",
      "x": 2797.7770643088043,
      "y": 4030.5905470493562,
      "width": 2013.531928182132,
      "height": 243.03643724696383,
      "angle": 0,
      "strokeColor": "#e03131",
