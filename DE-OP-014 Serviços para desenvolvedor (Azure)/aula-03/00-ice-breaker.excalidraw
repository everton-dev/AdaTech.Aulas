    {
      "id": "coD_BWsrfHoapMokak5lu",
      "type": "text",
      "x": 1185.0450254432726,
      "y": 5943.873708961912,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
