      "updated": 1739567915112,
      "link": null,
      "locked": false,
      "text": "1 - crie um arquivo chamado providers.tf e coloque o código abaixo:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 - crie um arquivo chamado providers.tf e coloque o código abaixo:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2rfRNaQxAnlkBnV9xXJ3D",
      "type": "text",
      "x": 3538.0272715735073,
      "y": -1487.2023809523807,
      "width": 868.9997558593749,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6I",
      "roundness": null,
      "seed": 968658252,
      "version": 261,
      "versionNonce": 1818528763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1739567915112,
      "link": null,
      "locked": false,
      "text": "terraform {\n  required_providers {\n    azurerm = {\n      source  = \"hashicorp/azurerm\"\n      version = \"~>3.0\"\n    }\n    random = {\n      source  = \"hashicorp/random\"\n      version = \"~>3.0\"\n    }\n  }\n}\n\nprovider \"azurerm\" {\n  features {}\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "terraform {\n  required_providers {\n    azurerm = {\n      source  = \"hashicorp/azurerm\"\n      version = \"~>3.0\"\n    }\n    random = {\n      source  = \"hashicorp/random\"\n      version = \"~>3.0\"\n    }\n  }\n}\n\nprovider \"azurerm\" {\n  features {}\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
