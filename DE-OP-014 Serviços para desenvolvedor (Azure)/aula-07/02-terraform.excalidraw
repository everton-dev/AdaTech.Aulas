      "locked": false,
      "text": "2 - crie um arquivo chamado main.tf e coloque o código abaixo:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 - crie um arquivo chamado main.tf e coloque o código abaixo:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DPOi8INGdoyKbf1lbKw0u",
      "type": "text",
      "x": 3520.307483975851,
      "y": -827.2023809523807,
      "width": 868.9997558593749,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6K",
      "roundness": null,
      "seed": 1252010228,
      "version": 327,
      "versionNonce": 1686636859,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1739567915112,
      "link": null,
      "locked": false,
      "text": "resource \"random_pet\" \"rg_name\" {\n  prefix = var.resource_group_name_prefix\n}\n\nresource \"azurerm_resource_group\" \"rg\" {\n  location = var.resource_group_location\n  name     = azure_for_devs\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "resource \"random_pet\" \"rg_name\" {\n  prefix = var.resource_group_name_prefix\n}\n\nresource \"azurerm_resource_group\" \"rg\" {\n  location = var.resource_group_location\n  name     = azure_for_devs\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
