      "seed": 1743374708,
      "version": 653,
      "versionNonce": 1403435547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1739567915112,
      "link": null,
      "locked": false,
      "text": "Step 1 - Create configurations (tf files main.tf, outputs.tf, providers.tf e variables.tf)\n\nStep 2 - Init terrarform\nterraform init -upgrade\n\nStep 2 - Check the execution plan\nterraform plan -out main.tfplan\n\nStep 3 - Build the Infraestructure\nterraform apply\n\nStep X - Destroy the Infra Instructure\nterraform apply main.tfplan\nterraform destroy # Se ele pedir para confirma, a não ser que você use \"--force\"",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1 - Create configurations (tf files main.tf, outputs.tf, providers.tf e variables.tf)\n\nStep 2 - Init terrarform\nterraform init -upgrade\n\nStep 2 - Check the execution plan\nterraform plan -out main.tfplan\n\nStep 3 - Build the Infraestructure\nterraform apply\n\nStep X - Destroy the Infra Instructure\nterraform apply main.tfplan\nterraform destroy # Se ele pedir para confirma, a não ser que você use \"--force\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
