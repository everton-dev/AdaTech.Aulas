      "isDeleted": false,
      "boundElements": [],
      "updated": 1739567915112,
      "link": null,
      "locked": false,
      "text": "variable \"resource_group_location\" {\n  type        = string\n  default     = \"brazilsouth\"\n  description = \"Location of the resource group.\"\n}\n\nvariable \"resource_group_name_prefix\" {\n  type        = string\n  default     = \"rg\"\n  description = \"Prefix of the resource group name\nthat's combined with a random ID so name is unique in\nyour Azure subscription.\"\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "variable \"resource_group_location\" {\n  type        = string\n  default     = \"brazilsouth\"\n  description = \"Location of the resource group.\"\n}\n\nvariable \"resource_group_name_prefix\" {\n  type        = string\n  default     = \"rg\"\n  description = \"Prefix of the resource group name that's combined with a random ID so name is unique in your Azure subscription.\"\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
