    {
      "id": "7zM9qjV4i1A8H0TWPsl9Y",
      "type": "text",
      "x": 1025.563798480564,
      "y": 1613.343253968255,
      "width": 1885.0000000000005,
      "height": 1150,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4q",
      "roundness": null,
      "seed": 566764991,
      "version": 877,
      "versionNonce": 527601239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1737561246332,
      "link": null,
      "locked": false,
      "text": "# Criar um grupo de recursos caso não exista\naz group create --name azure-for-devs --location eastus\n\n# Crie um serviço de API Management\naz apim create --resource-group azure-for-devs --name AdaServiceAPI --publisher-name AdaTech --publisher-email azure@adatech.com.br --location eastus\n\n# Crie uma API dentro do serviço de API Management\naz apim api create --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --display-name \"Adatech API Core Test\" --path AdaAPICore --protocols\nhttps\n\n# Adicione uma operação à API criada\naz apim api operation create --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --operation-id core-operacion --display-name \"Ada Core\nOperação\" --method GET --url-template \"/ada-core-operacao\"\n\n# Crie um produto que agrupará uma ou mais APIs\naz apim product create --resource-group azure-for-devs --service-name AdaServiceAPI --product-id AdaTechPortal --display-name \"Portal Test Ada\" --approval-required false -\n-subscription-required true --state published\n\n# Associe a API criada ao produto\naz apim product api add --resource-group azure-for-devs --service-name AdaServiceAPI --product-id AdaTechPortal --api-id adaCoreAPI\n\n# Publique o portal do desenvolvedor\naz apim update --resource-group azure-for-devs --name AdaServiceAPI --set developerPortal.enabled=true\n\n# Adicione políticas de API\naz apim api policy set --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --policy-xml'\n<policies>\n    <inbound>\n        <rate-limit calls=\"10\" renewal-period=\"60\"></rate-limit>\n    </inbound>\n    <backend>\n        <forward-request />\n    </backend>\n    <outbound />\n    <on-error>\n        <retry interval=\"1\" count=\"3\" />\n    </on-error>\n</policies>'\n\n# Configure integrações com o Azure Monitor\naz monitor log-analytics workspace create --resource-group azure-for-devs --workspace-name AdaWorkspace\n\naz monitor diagnostic-settings create --resource-group azure-for-devs --resource-id \"/subscriptions/{subscription-id}/resourceGroups/azure-for-\ndevs/providers/Microsoft.ApiManagement/service/AdaServiceAPI\" --workspace \"/subscriptions/{subscription-id}/resourceGroups/azure-for-\ndevs/providers/Microsoft.OperationalInsights/workspaces/AdaWorkspace\" --logs '[{\"category\": \"GatewayLogs\", \"enabled\": true, \"retentionPolicy\": {\"days\": 0, \"enabled\":\nfalse}}]'",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Criar um grupo de recursos caso não exista\naz group create --name azure-for-devs --location eastus\n\n# Crie um serviço de API Management\naz apim create --resource-group azure-for-devs --name AdaServiceAPI --publisher-name AdaTech --publisher-email azure@adatech.com.br --location eastus\n\n# Crie uma API dentro do serviço de API Management\naz apim api create --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --display-name \"Adatech API Core Test\" --path AdaAPICore --protocols https\n\n# Adicione uma operação à API criada\naz apim api operation create --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --operation-id core-operacion --display-name \"Ada Core Operação\" --method GET --url-template \"/ada-core-operacao\"\n\n# Crie um produto que agrupará uma ou mais APIs\naz apim product create --resource-group azure-for-devs --service-name AdaServiceAPI --product-id AdaTechPortal --display-name \"Portal Test Ada\" --approval-required false --subscription-required true --state published\n\n# Associe a API criada ao produto\naz apim product api add --resource-group azure-for-devs --service-name AdaServiceAPI --product-id AdaTechPortal --api-id adaCoreAPI\n\n# Publique o portal do desenvolvedor\naz apim update --resource-group azure-for-devs --name AdaServiceAPI --set developerPortal.enabled=true\n\n# Adicione políticas de API\naz apim api policy set --resource-group azure-for-devs --service-name AdaServiceAPI --api-id adaCoreAPI --policy-xml'\n<policies>\n    <inbound>\n        <rate-limit calls=\"10\" renewal-period=\"60\"></rate-limit>\n    </inbound>\n    <backend>\n        <forward-request />\n    </backend>\n    <outbound />\n    <on-error>\n        <retry interval=\"1\" count=\"3\" />\n    </on-error>\n</policies>'\n\n# Configure integrações com o Azure Monitor\naz monitor log-analytics workspace create --resource-group azure-for-devs --workspace-name AdaWorkspace\n\naz monitor diagnostic-settings create --resource-group azure-for-devs --resource-id \"/subscriptions/{subscription-id}/resourceGroups/azure-for-devs/providers/Microsoft.ApiManagement/service/AdaServiceAPI\" --workspace \"/subscriptions/{subscription-id}/resourceGroups/azure-for-devs/providers/Microsoft.OperationalInsights/workspaces/AdaWorkspace\" --logs '[{\"category\": \"GatewayLogs\", \"enabled\": true, \"retentionPolicy\": {\"days\": 0, \"enabled\": false}}]'",
      "autoResize": false,
      "lineHeight": 1.25
    },
