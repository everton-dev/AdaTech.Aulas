    {
      "id": "_LjXfY8ypLcivNYMwWX3m",
      "type": "text",
      "x": 1327.3695117496627,
      "y": 5096.3816678849835,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
