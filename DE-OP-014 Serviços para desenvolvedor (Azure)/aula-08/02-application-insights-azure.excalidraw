    {
      "id": "tqmtas_rfd31nDoj2v69e",
      "type": "text",
      "x": 334.9428753323018,
      "y": 2695.88888888889,
      "width": 2059.2861328124995,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
