    {
      "id": "VemMnZ5eqcZGFf2lTzfAs",
      "type": "text",
      "x": 1274.7115240080184,
      "y": 6008.237973681198,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
