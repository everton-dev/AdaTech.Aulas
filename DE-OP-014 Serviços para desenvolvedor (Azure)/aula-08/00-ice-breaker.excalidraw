    {
      "id": "EQrrRq4YD80Uw2VweoLoa",
      "type": "text",
      "x": 1156.347471371978,
      "y": 4581.233703979719,
      "width": 2159.61083984375,
      "height": 241.370152478615,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
      "strokeWidth": 1,
