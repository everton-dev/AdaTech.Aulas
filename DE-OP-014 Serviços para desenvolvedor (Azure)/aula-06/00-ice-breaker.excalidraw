      "type": "text",
      "x": -2749.7455641542037,
      "y": 6971.159022534978,
      "width": 2193.390133806008,
      "height": 241.37015247861504,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
