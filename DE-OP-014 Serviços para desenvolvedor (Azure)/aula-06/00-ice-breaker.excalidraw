      "type": "text",
      "x": 255.49604529366115,
      "y": -2180.3697067295398,
      "width": 1074.02587890625,
      "height": 497.8166663213069,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCy",
      "roundness": null,
      "seed": 1524552442,
      "version": 1953,
      "versionNonce": 1916123962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769015898903,
      "link": null,
      "locked": false,
      "text": "Por favor!\n- Cameras ligadas.\n- Entrem no horário: Inicio e Intervalo.\n- Participem da aula.\n- Tirem dúvidas.\n- Levantem a mão para tirar dúvidas.\n- Intervalo: 16:30 BRT",
      "fontSize": 56.89333329386364,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por favor!\n- Cameras ligadas.\n- Entrem no horário: Inicio e Intervalo.\n- Participem da aula.\n- Tirem dúvidas.\n- Levantem a mão para tirar dúvidas.\n- Intervalo: 16:30 BRT",
      "autoResize": true,
      "lineHeight": 1.25
    },
