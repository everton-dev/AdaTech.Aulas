      "x": -2622.9977112234665,
      "y": 8480.42387007453,
      "width": 3290.419044447259,
      "height": 362.0919663291494,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
