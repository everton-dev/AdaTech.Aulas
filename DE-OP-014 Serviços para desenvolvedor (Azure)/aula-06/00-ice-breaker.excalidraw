    {
      "id": "SDT47JrVcC5vIBXAoZ6yI",
      "type": "text",
      "x": 369.5307113813051,
      "y": 4585.890665775171,
      "width": 2906.041748046875,
      "height": 1825.9693447625625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCg",
