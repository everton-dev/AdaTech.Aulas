    },
    {
      "id": "-OBMxD9KjmdsdVMMC5-H5",
      "type": "text",
      "x": 1341.680084500853,
      "y": 7695.704378663483,
      "width": 3066.559090337539,
      "height": 370.1384544697975,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDT",
      "roundness": null,
      "seed": 342524755,
      "version": 3293,
      "versionNonce": 923924925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776704421983,
      "link": null,
      "locked": false,
      "text": "- O que achou do trabalho?\n- Quais foram os desafios?\n- O que você aprendeu?\n- Procedimentos: como criou os recursos e como publicou.",
      "fontSize": 74.0276908939595,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- O que achou do trabalho?\n- Quais foram os desafios?\n- O que você aprendeu?\n- Procedimentos: como criou os recursos e como publicou.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
