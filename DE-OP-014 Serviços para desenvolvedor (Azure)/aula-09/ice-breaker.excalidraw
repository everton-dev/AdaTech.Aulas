    {
      "id": "F5cEG56av4702lKkBlzb2",
      "type": "text",
      "x": 4284.898664812269,
      "y": 3593.3939229518455,
      "width": 2906.041748046875,
      "height": 1825.9693447625625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#343a40",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
